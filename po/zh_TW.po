#: src/driver.rs
msgid "DKMS backend unavailable: the lssbi_probe module is not loaded; run `sudo modprobe lssbi_probe`"
msgstr "DKMS 後端無法使用：lssbi_probe 模組尚未載入；請執行 `sudo modprobe lssbi_probe`"

#: src/driver.rs
msgid "Invalid Linux CPU value \"{value}\": expected a non-negative decimal integer"
msgstr "Linux 處理器值 「{value}」 無效：應為非負十進位整數"

#: src/driver.rs
msgid "Linux CPU #{cpu} exceeds the supported affinity range (maximum #{max})"
msgstr "Linux 處理器 #{cpu} 超出支援的處理器親和性範圍（最大編號為 #{max}）"

#: src/driver.rs
msgid "Linux CPU #{cpu} is not in this process's allowed CPU set; it may be offline or excluded by an affinity/cpuset restriction"
msgstr "Linux 處理器 #{cpu} 無法使用：可能已離線，或不允許目前程序使用"

#: src/driver.rs
msgid "Cannot select Linux CPU #{cpu}: {error}"
msgstr "無法選擇 Linux 處理器 #{cpu}：{error}"

